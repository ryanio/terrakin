{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=8787", "pnpm", "dev"],
      "port": 5173
    },
    {
      "name": "dev-test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:test"],
      "port": 5183
    },
    {
      "name": "built",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TERRAKIN_STATIC_DIR=packages/client/dist",
        "pnpm",
        "--filter",
        "@terrakin/server",
        "start"
      ],
      "port": 8788,
      "autoPort": true
    },
    {
      "name": "dev-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TERRAKIN_SERVER=https://terrakin.org",
        "TERRAKIN_CLIENT_PORT=5193",
        "pnpm",
        "--filter",
        "@terrakin/client",
        "dev"
      ],
      "port": 5193
    }
  ]
}
