{
  "name": "@terrakin/client",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first web client for Terrakin. Renders what the server says; decides nothing.",
  "type": "module",
  "scripts": {
    "dev": "vite --host --configLoader runner",
    "build": "tsc -p tsconfig.json && vite build --configLoader runner && vite build --configLoader runner --config vite.docs.config.ts",
    "preview": "vite preview --host --configLoader runner",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@scalar/api-reference": "1.72.4",
    "@sentry/browser": "11.4.0",
    "@terrakin/protocol": "workspace:*",
    "@terrakin/sim": "workspace:*",
    "@terrakin/ui": "workspace:*",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "vite": "8.3.2"
  }
}
