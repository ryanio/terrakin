{
  "name": "@terrakin/client",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first web client for Terrakin. Renders what the server says; decides nothing.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@sentry/browser": "11.4.0",
    "@terrakin/protocol": "workspace:*",
    "@terrakin/sim": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.2"
  }
}
