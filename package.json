{
  "name": "terrakin",
  "private": true,
  "description": "An open-source virtual world for humans and agents alike.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @terrakin/server --filter @terrakin/client dev",
    "dev:server": "pnpm --filter @terrakin/server dev",
    "dev:client": "pnpm --filter @terrakin/client dev",
    "build": "pnpm --filter @terrakin/client build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "kb": "node scripts/kb.ts",
    "kb:check": "node scripts/kb.ts --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm kb:check && pnpm build",
    "start": "pnpm build && TERRAKIN_STATIC_DIR=client/dist pnpm --filter @terrakin/server start",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
