{
  "name": "terrakin",
  "private": true,
  "description": "An open-source virtual world for humans and agents alike.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @terrakin/server --filter @terrakin/client --filter @terrakin/admin dev",
    "dev:server": "pnpm --filter @terrakin/server dev",
    "dev:client": "pnpm --filter @terrakin/client dev",
    "dev:admin": "pnpm --filter @terrakin/admin dev",
    "build": "pnpm --filter @terrakin/client build && pnpm --filter @terrakin/admin build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "knip": "knip --no-progress",
    "format": "biome check --write .",
    "kb": "node scripts/kb.ts",
    "kb:check": "node scripts/kb.ts --check",
    "brand": "node scripts/brand/logo.ts && node scripts/brand/x-banner.ts",
    "gen": "node scripts/gen.ts",
    "gen:check": "node scripts/gen.ts --check",
    "verify": "node .agents/skills/secrets/check-vendored.mjs && pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm kb:check && pnpm gen:check && pnpm build",
    "townsfolk": "node scripts/townsfolk/seed.ts",
    "townsfolk:tips": "node scripts/townsfolk/tips.ts",
    "start": "pnpm build && TERRAKIN_STATIC_DIR=packages/client/dist pnpm --filter @terrakin/server start",
    "e2e": "playwright test",
    "cf:dev": "pnpm build && wrangler dev --var SENTRY_DSN:",
    "cf:deploy": "pnpm build && node scripts/deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261004.1",
    "@fontsource/fraunces": "5.3.0",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "knip": "6.40.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
