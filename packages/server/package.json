{
  "name": "@terrakin/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Terrakin server: REST + WebSocket API v1 over the deterministic sim.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p cloudflare/tsconfig.json"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.4.0",
    "@sentry/core": "11.4.0",
    "@terrakin/cards": "workspace:*",
    "@terrakin/protocol": "workspace:*",
    "@terrakin/sim": "workspace:*",
    "@terrakin/ui": "workspace:*",
    "tsx": "4.23.15",
    "undici": "7.29.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2"
  }
}
