{
  // terrakin.org on Cloudflare Workers. See docs/deploy.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrakin",
  "main": "server/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first so it can redirect www and route /v1/* to the world.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "terrakin-media" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "routes": [
    { "pattern": "terrakin.org", "custom_domain": true },
    { "pattern": "www.terrakin.org", "custom_domain": true }
  ]
}
